# Copy to .env and edit before `docker compose up -d --build`.

# Database inside the Compose network.
POSTGRES_USER=pixtooth
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=pixtooth
DATABASE_POOL_MAX=10

# Generate both with: openssl rand -hex 32
JWT_SECRET=change-this-jwt-secret
REFRESH_TOKEN_SECRET=change-this-refresh-secret

# Accounts allowed into the admin app, comma separated. Register the account in the clinic
# app first, then restart the API after adding the address here.
PLATFORM_ADMIN_EMAILS=admin@example.com

# Origins baked into the web and admin builds, and allowed by CORS.
# Use your real domains when the stack is behind a reverse proxy.
PUBLIC_API_URL=http://localhost:3100
PUBLIC_WEB_ORIGIN=http://localhost:8080
PUBLIC_ADMIN_ORIGIN=http://localhost:8081

# Optional integrations. Leave empty to run without them.
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
GOOGLE_CLIENT_ID=
PASSWORD_RESET_URL=http://localhost:8080/reset-password
AI_ANALYSIS_ENABLED=false
MODAL_INFERENCE_URL=

# Stripe billing: one license, $30/month or $300/year. Create both prices in Stripe and
# paste the price_... IDs. The webhook points at http://<api-host>/api/billing/webhook.
# Leave all four empty to keep checkout hidden.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
