PORT=3100
HOST=127.0.0.1
NODE_ENV=production
CORS_ORIGIN=https://app.pixtooth.com,http://localhost:5173

# Database driver: dynamo (default) or postgres. Both use the same repositories.
# Postgres needs a long-running Node process and a connection pool, so it is available on
# local, VPS, Docker and Kubernetes hosts. Lambda and the Cloudflare Worker use DynamoDB.
DB_DRIVER=dynamo

# DynamoDB
AWS_REGION=eu-central-1
DYNAMODB_TABLE_NAME=DentalChart

# PostgreSQL (DB_DRIVER=postgres)
# Full connection URL, for example postgres://user:password@host:5432/pixtooth.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SCHEMA=public
# Creates the documents table on first use. Set false when migrations run separately.
DATABASE_AUTO_MIGRATE=true
# Pool per process. With PM2 cluster mode the database sees this value times the number
# of workers, so keep it well below the PostgreSQL max_connections limit.
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=10000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# Platform administrators for the separate admin app (apps/admin). Comma-separated
# e-mail addresses; an account signs in with its normal password and gets the admin API.
# Leave empty to keep the admin app closed.
PLATFORM_ADMIN_EMAILS=

# Security
JWT_SECRET=replace-me
REFRESH_TOKEN_SECRET=replace-me

# Sessions: access token lifetime and the sliding refresh window.
# A refresh token is renewed on every use, so 365d means "logged out after a year of
# not opening the app". Every visit resets the clock, so returning users stay signed in.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=365d
# How long a just-rotated refresh token may be replayed without treating it as theft.
# This is what keeps two open tabs (or a lost response) from ending the session.
REFRESH_TOKEN_REUSE_GRACE_MS=10000

# Sign-in with Google (Google Identity Services). Create an OAuth 2.0 "Web application"
# client and put its client id here AND in the frontend build as VITE_GOOGLE_CLIENT_ID.
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=

# Optional service flags
ENABLE_TELEMETRY=false
AI_ANALYSIS_ENABLED=false

# Outbound email. EMAIL_PROVIDER picks the transport: resend | cloudflare | gmail.
# When it is unset, the first fully configured provider wins (resend, cloudflare, gmail),
# so switching providers is a one-variable change.
EMAIL_PROVIDER=resend
EMAIL_FROM=Pixtooth <no-reply@pixtooth.com>
PASSWORD_RESET_URL=https://app.pixtooth.com/reset-password

# Resend: https://resend.com (API key + verified sending domain)
RESEND_API_KEY=

# Cloudflare Email Service: requires the Workers Paid plan; verified sending domain in the dashboard
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=

# Gmail API: legacy transport, OAuth client with a Gmail send scope
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
GMAIL_FROM_EMAIL=

# Stripe billing. There is one license: $30/month or $300/year. Create both prices in
# Stripe, then paste their price_... IDs. The webhook endpoint is
# https://<api-host>/api/billing/webhook and listens to checkout.session.completed,
# customer.subscription.*, invoice.paid and invoice.payment_failed.
# All four values are required together; leave them empty to hide checkout and portal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Where Stripe sends the browser back. Defaults are built from PUBLIC_WEB_ORIGIN.
# PUBLIC_WEB_ORIGIN=https://app.pixtooth.com
# BILLING_SUCCESS_URL=https://app.pixtooth.com/?billing=success
# BILLING_CANCEL_URL=https://app.pixtooth.com/?billing=cancelled
# BILLING_PORTAL_RETURN_URL=https://app.pixtooth.com/?billing=portal
