# Deployment settings shared by the two serverless targets.
#
# Copy to .env.deploy and fill in. The file is gitignored, and both deploy scripts read
# it: scripts/deploy-lambda.mjs maps these names onto CloudFormation parameters,
# scripts/deploy-worker.mjs pushes them to the Worker as secrets.

# --- shared ---------------------------------------------------------------
AWS_REGION=eu-central-1
# The AWS account that holds the DynamoDB table and the policies over it. The Lambda path
# never reads this: SAM creates the function's role and CloudFormation resolves the
# account itself. The Worker path does, because nothing attaches a role to it — its
# DynamoDB policy is written by hand against this account, and any role it assumes is
# composed from it.
AWS_ACCOUNT_ID=
DYNAMODB_TABLE_NAME=DentalChart
CORS_ORIGIN=https://app.pixtooth.com
PASSWORD_RESET_URL=https://app.pixtooth.com/reset-password

# Signing keys. Leave both empty and run
#   npm run deploy:lambda -- --generate-secrets
# to create them once; later deploys reuse them, so open sessions survive.
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Optional integrations
GOOGLE_CLIENT_ID=
EMAIL_PROVIDER=resend
EMAIL_FROM=
RESEND_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
MODAL_INFERENCE_URL=
AI_ANALYSIS_ENABLED=false
ENABLE_TELEMETRY=false
TELEMETRY_EXPORT_SECRET=

# --- AWS Lambda + API Gateway --------------------------------------------
STACK_NAME=pixtooth
# Public hostname the API answers on.
API_DOMAIN=api.pixtooth.com
# ACM certificate ARN for API_DOMAIN, issued in AWS_REGION. See docs/serverless-deployment.md.
API_CERTIFICATE_ARN=
# SAM uploads the ~26 MB artifact through S3, so it needs a bucket in the same region.
ARTIFACTS_BUCKET=

# --- Cloudflare Workers ---------------------------------------------------
# The Worker reads its app settings from Worker secrets, so scripts/deploy-worker.mjs
# pushes every value it recognises as one and uses WORKER_DOMAIN from here. Deploying
# needs a CLOUDFLARE_API_TOKEN in the shell (or a previous `wrangler login`).
#
# DynamoDB credentials exist only on this path. Lambda reaches the table through the role
# template.yaml attaches, so it never reads the three below. A Worker has no role to
# attach, so the keys have to live in its secrets. Give them an IAM user whose policy
# covers the table and nothing else: this is the identity the public Worker runs as, and
# it is not the identity that deploys the Lambda stack.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for credentials that are already temporary (AssumeRole, SSO). Empty otherwise.
AWS_SESSION_TOKEN=
#
# The Worker serves the frontend and the API on one hostname, so this is the domain the
# app answers on. Leave it empty to deploy to <worker>.<subdomain>.workers.dev only, and
# attach the domain in the Cloudflare dashboard afterwards.
WORKER_DOMAIN=app.pixtooth.com

# --- Legacy VPS deploy ----------------------------------------------------
# Only used by the old rsync + PM2 flow in package.json and
# .github/workflows/deploy-backend.yml.
VPS_IP=
VPS_USER=
