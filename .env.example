VITE_API_URL=http://localhost:3001
VITE_DEV_MODE=false
VITE_GA_MEASUREMENT_ID=

# OAuth 2.0 "Web application" client id from Google Cloud Console. The same value must be
# set as GOOGLE_CLIENT_ID on the server, otherwise the token cannot be verified.
# Leave empty to hide the "Continue with Google" button.
VITE_GOOGLE_CLIENT_ID=
